+/**
+ * V Momentum API client.
+ *
+ * Single source of truth for talking to the backend (turbillon50/v-momentum-backend).
+ * Reads NEXT_PUBLIC_API_URL at build time. When unset (e.g. preview builds without
+ * the var) calls fall back to a no-op mode that returns mock-shaped data so the
+ * UI never breaks.
+ */
+
+const API_URL = (process.env.NEXT_PUBLIC_API_URL || '').replace(/\/$/, '')
+
+export const apiEnabled = Boolean(API_URL)
+
+export class ApiError extends Error {
+  status: number
+  details?: unknown
+  constructor(message: string, status: number, details?: unknown) {
+    super(message)
+    this.status = status
+    this.details = details
+  }
+}
+
+async function request<T>(method: string, path: string, body?: unknown): Promise<T> {
+  if (!API_URL) {
+    // Soft-fail: app stays usable without a backend wired up.
+    throw new ApiError('NEXT_PUBLIC_API_URL is not set', 0)
+  }
+
+  const res = await fetch(`${API_URL}${path}`, {
+    method,
+    headers: { 'content-type': 'application/json' },
+    body: body ? JSON.stringify(body) : undefined,
+  })
+
+  const text = await res.text()
+  let payload: any = null
+  try { payload = text ? JSON.parse(text) : null } catch { payload = text }
+
+  if (!res.ok) {
+    const message = (payload && payload.message) || `HTTP ${res.status}`
+    throw new ApiError(message, res.status, payload)
+  }
+  return payload as T
+}
+
+export type LeadInput = {
+  name: string
+  whatsapp: string
+  email: string
+  company?: string
+  projectType?: string
+  plan?: string
+  storePublish?: string
+  urgency?: string
+  description?: string
+  consent: boolean
+}
+
+export type Lead = LeadInput & {
+  id: string
+  createdAt: string
+  estatus: string
+}
+
+export const api = {
+  health: () => request<{ ok: boolean; mockMode: boolean }>('GET', '/api/health'),
+
+  createLead: (input: LeadInput) =>
+    request<{ data: Lead }>('POST', '/api/leads', input),
+
+  getIntegrations: () =>
+    request<{ categories: any[]; meta: { mockMode: boolean; total: number } }>(
+      'GET',
+      '/api/integrations',
+    ),
+
+  getPricing: () => request<any>('GET', '/api/pricing'),
+
+  ask: (message: string, context?: 'inicio' | 'proceso' | 'integraciones' | 'precios') =>
+    request<{ sessionId: string; response: { content: string; intent: string; navigate?: string; suggestions?: string[] } }>(
+      'POST',
+      '/api/assistant',
+      { message, context },
+    ),
+}
