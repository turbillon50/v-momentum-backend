# =============================================================================
# V Momentum Backend — environment example
# Copy to `.env` and fill in only what you need. All integrations start in
# MOCK_MODE=true so the API works end-to-end without any real key.
# =============================================================================

# Runtime
NODE_ENV=development
PORT=4000
MOCK_MODE=true

# CORS — comma separated list of allowed PWA origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Public URL the frontend uses to reach this API
# (set this on the frontend project, mirrored here for documentation)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (not required while MOCK_MODE=true)
DATABASE_URL=

# Auth
CLERK_SECRET_KEY=

# Email
RESEND_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADO_PAGO_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# AI providers (assistant "V")
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Legal / KYC
DOCUSIGN_KEY=
SUMSUB_KEY=

# Infra
CLOUDFLARE_TOKEN=

# Automation / forms
MAKE_WEBHOOK_SECRET=
JOTFORM_WEBHOOK_SECRET=
